# ShelfLog — Environment Variables
# Copy this file to .env and fill in your Supabase project values.
# NEVER put sb_secret_... keys in frontend environment files.

# Supabase project origin URL (without /rest/v1/)
VITE_API_BASE_URL=https://your-project-ref.supabase.co

# Supabase publishable / anon client key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
